{
  "name": "zipline-tole",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "dependencies": {
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "playwright": "1.49.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "validate:levels": "node -e \"console.log('validate:levels: no levels yet (M1+)')\""
  }
}
